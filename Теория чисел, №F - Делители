#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(0);
    cin.tie(0);
    int n;
    cin >> n;
    vector<int> cnt(8, 0);
    for (int i=0;i<n;i++) {
        int x;
        cin >> x;
        cnt[x]++;
    }
    if (cnt[5] > 0 || cnt[7] > 0) {
        cout << -1 << "\n";
        return 0;
    }
    vector<tuple<int, int, int>> ans;
    while (cnt[3] > 0) {
        if (cnt[1] == 0 || cnt[6] == 0) {
            cout << -1 << "\n";
            return 0;
        }
        ans.push_back({1, 3, 6});
        cnt[1]--;
        cnt[3]--;
        cnt[6]--;
    }
    while (cnt[4]>0) {
        if (cnt[1] == 0 || cnt[2] == 0) {
            cout << -1 << "\n";
            return 0;
        }
        ans.push_back({1, 2, 4});
        cnt[1]--;
        cnt[2]--;
        cnt[4]--;
    }
    while (cnt[6]>0) {
        if (cnt[1] == 0 || cnt[2] == 0) {
            cout << -1 << "\n";
            return 0;
        }
        ans.push_back({1, 2, 6});
        cnt[1]--;
        cnt[2]--;
        cnt[6]--;
    }
    for (int i=1;i<=7;i++) {
        if (cnt[i] > 0) {
            cout << -1 << "\n";
            return 0;
        }
    }
    for (auto [a, b, c] : ans) {
        cout << a << " " << b << " " << c << "\n";
    }
}
