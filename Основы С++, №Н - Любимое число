#include <bits/stdc++.h>
using namespace std;
using ll = long long;
 
int main() {
    ios::sync_with_stdio(0);
    cin.tie(0);
    ll n, k;
    cin >> n >> k;
    ll p = 1;
    bool flag = false;
    for (ll i=0;i<k;i++){
        p *= 2; 
    }
    ll x = (n/p)*p;
    while (x > 0) {
        if ((x/p)%2 == 1){
            cout << x << "\n";
            flag = true;
            break;
        }
        x -= p;
    }
    
    if (!flag){
        cout << -1 << "\n";
    }
}
